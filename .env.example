NODE_ENV=production
PORT=4000
GRPC_PORT=50051
# Keep plaintext gRPC private to the host. Configure both TLS files before exposing it.
GRPC_BIND_ADDRESS=127.0.0.1
GENOS_DB_PATH=/data/genos.db
GENOS_AGENT_EXECUTOR=local
GENOS_SQLITE_MMAP_SIZE=268435456
GENOS_SQLITE_SYNCHRONOUS=FULL
GENOS_PROCESS_GRACE_MS=5000
GENOS_ALLOWED_ORIGINS=
GENOS_GRPC_SHARED_SECRET=

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
# GENOS_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions

# Required in production:
# GENOS_ADMIN_TOKEN=
# GENOS_ADMIN_PASSWORD=
# GENOS_SECRET_KEY=
# GENOS_PROMOTION_SECRET=
# GENOS_AGENT_GIT_SIGNING_SECRET=
# GENOS_GRPC_TLS_KEY=/run/secrets/genos-grpc.key
# GENOS_GRPC_TLS_CERT=/run/secrets/genos-grpc.crt
