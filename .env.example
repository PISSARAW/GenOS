NODE_ENV=production
PORT=4000
GRPC_PORT=50051
# Keep plaintext gRPC private to the host. Configure both TLS files before exposing it.
GRPC_BIND_ADDRESS=127.0.0.1
# GENOS_DB_PATH=/data/genos.db
# New installations select a local volume automatically. Optional restrictions:
# GENOS_STORAGE_CANDIDATES=/data:/mnt/fast
# GENOS_STORAGE_MIN_FREE_BYTES=1073741824
# GENOS_DATA_ROOT=/data/genos
GENOS_AGENT_EXECUTOR=local
GENOS_SQLITE_MMAP_SIZE=268435456
GENOS_SQLITE_SYNCHRONOUS=FULL
GENOS_PROCESS_GRACE_MS=5000
GENOS_ALLOWED_ORIGINS=
GENOS_GRPC_SHARED_SECRET=

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
# GENOS_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions

# Required in production:
# GENOS_ADMIN_TOKEN=
# GENOS_ADMIN_PASSWORD=
# GENOS_SECRET_KEY=
# GENOS_PROMOTION_SECRET=
# GENOS_AGENT_GIT_SIGNING_SECRET=
# GENOS_GRPC_TLS_KEY=/run/secrets/genos-grpc.key
# GENOS_GRPC_TLS_CERT=/run/secrets/genos-grpc.crt
# Set client CA to require mTLS on gRPC; REQUIRED=1 also fails closed when files are missing.
# GENOS_GRPC_CLIENT_CA=/run/secrets/genos-client-ca.crt
# GENOS_GRPC_MTLS_REQUIRED=1
# Optional HTTPS+mTLS for the REST API (requires a trusted client certificate on every request).
# GENOS_HTTP_TLS_KEY=/run/secrets/genos-http.key
# GENOS_HTTP_TLS_CERT=/run/secrets/genos-http.crt
# GENOS_HTTP_CLIENT_CA=/run/secrets/genos-client-ca.crt
# GENOS_HTTP_MTLS_REQUIRED=1
# Secret provider defaults to encrypted SQLite. Vault mode stores values only in Vault KV v2.
# GENOS_SECRETS_PROVIDER=hashicorp-vault
# GENOS_VAULT_ADDR=https://vault.example.com
# GENOS_VAULT_KV_MOUNT=secret
# GENOS_VAULT_TOKEN_FILE=/run/secrets/vault-token
