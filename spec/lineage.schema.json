{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/lineage.schema.json",
  "title": "LineageEdge",
  "type": "object",
  "required": ["parent_snapshot", "child_snapshot", "relation", "created_at"],
  "properties": {
    "parent_snapshot": { "type": "string" },
    "child_snapshot": { "type": "string" },
    "relation": {
      "type": "string",
      "enum": ["FORK", "RESTORE", "REPLAY", "MUTATION", "IMPORT", "MERGE"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
