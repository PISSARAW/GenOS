{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.dev/spec/branch-evolution.schema.json",
  "title": "GenOS Budgeted Branch Evolution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["config", "branches"],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_compute_units", "minimum_evaluation_units", "survival_threshold", "max_depth", "max_children_per_branch"],
      "properties": {
        "total_compute_units": { "type": "integer", "minimum": 1 },
        "minimum_evaluation_units": { "type": "integer", "minimum": 1 },
        "survival_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_depth": { "type": "integer", "minimum": 0 },
        "max_children_per_branch": { "type": "integer", "minimum": 1 },
        "max_survivors_per_generation": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "score"],
        "properties": {
          "branch_id": { "type": "string", "minLength": 1 },
          "parent_branch_id": { "type": ["string", "null"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "children": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          }
        }
      }
    }
  }
}
