{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/ontology-relation.schema.json",
  "title": "OntologyRelation",
  "type": "object",
  "required": ["apiVersion", "kind", "source", "relationType", "target"],
  "properties": {
    "apiVersion": { "type": "string", "const": "genos.ontology/v1" },
    "kind": { "type": "string", "const": "OntologyRelation" },
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "relationType": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
