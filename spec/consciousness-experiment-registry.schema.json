{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/consciousness-experiment-registry.schema.json",
  "title": "GenOS consciousness experiment registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "indicatorRegistrySchema", "claimVocabularySchema", "status", "constraints", "theories"],
  "properties": {
    "schema": { "const": "genos.consciousness-experiment-registry/v1" },
    "indicatorRegistrySchema": { "const": "genos.indicator-registry/v1" },
    "claimVocabularySchema": { "const": "genos.consciousness-claim-vocabulary/v1" },
    "status": { "const": "research_only" },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["pairedControlRequired", "preregisteredThresholdsRequired", "sharedLocksRequired", "phenomenalInferenceAllowed", "promotionAllowed"],
      "properties": {
        "pairedControlRequired": { "const": true },
        "preregisteredThresholdsRequired": { "const": true },
        "sharedLocksRequired": { "type": "array", "const": ["model", "toolset", "budget"] },
        "phenomenalInferenceAllowed": { "const": false },
        "promotionAllowed": { "const": false }
      }
    },
    "theories": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/theory" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "theory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "hypotheses"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "hypotheses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hypothesis" } }
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "indicatorIds", "familyIds", "control", "ablation", "primaryOutcome", "invalidationCondition", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "indicatorIds": { "$ref": "#/$defs/ids" },
        "familyIds": { "$ref": "#/$defs/ids", "minItems": 1 },
        "control": { "$ref": "#/$defs/text" },
        "ablation": { "$ref": "#/$defs/text" },
        "primaryOutcome": {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "direction", "measurement"],
          "properties": {
            "metric": { "$ref": "#/$defs/id" },
            "direction": { "enum": ["increase", "decrease"] },
            "measurement": { "$ref": "#/$defs/text" }
          }
        },
        "invalidationCondition": { "$ref": "#/$defs/text" },
        "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
