{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/heredity-experiment.schema.json",
  "title": "HeredityExperiment",
  "type": "object",
  "required": [
    "experiment_id",
    "common_ancestor_snapshot",
    "genome_digest",
    "inheritance_policy",
    "cohort",
    "evaluation_suite"
  ],
  "properties": {
    "experiment_id": { "type": "string", "minLength": 1 },
    "common_ancestor_snapshot": { "type": "string", "minLength": 1 },
    "genome_digest": { "type": "string", "pattern": "^sha256:" },
    "inheritance_policy": {
      "type": "object",
      "required": ["genome", "memory", "phenotype", "state"],
      "properties": {
        "genome": { "const": "copy" },
        "memory": { "enum": ["copy", "reset"] },
        "phenotype": { "enum": ["copy", "reset"] },
        "state": { "enum": ["copy", "reset"] }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "environment": { "type": "string" },
        "random_seed_policy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "cohort": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["agent_id", "baseline_snapshot", "treatment"],
        "properties": {
          "agent_id": { "type": "string" },
          "baseline_snapshot": { "type": "string" },
          "treatment": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "duration": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "evaluation_suite": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}

