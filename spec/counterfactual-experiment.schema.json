{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/counterfactual-experiment.schema.json",
  "title": "CounterfactualExperiment",
  "type": "object",
  "required": ["experiment_id", "root", "controls", "branches", "evaluation", "resolution"],
  "properties": {
    "experiment_id": { "type": "string" },
    "root": {
      "type": "object",
      "required": ["agent_snapshot", "world_snapshot", "genome_digest"],
      "properties": {
        "agent_snapshot": { "type": "string" },
        "world_snapshot": { "type": "string" },
        "genome_digest": { "type": "string", "pattern": "^sha256:" }
      }
    },
    "controls": {
      "type": "object",
      "required": ["runtime_manifest", "model_manifest", "tool_manifest", "permission_manifest"],
      "properties": {
        "runtime_manifest": { "type": "string" },
        "model_manifest": { "type": "string" },
        "tool_manifest": { "type": "string" },
        "permission_manifest": { "type": "string" }
      },
      "additionalProperties": true
    },
    "branches": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["branch_id", "agent_snapshot", "world_id", "event_stream", "budget", "hypothesis", "intervention"],
        "properties": {
          "branch_id": { "type": "string" },
          "agent_snapshot": { "type": "string" },
          "world_id": { "type": "string" },
          "event_stream": { "type": "string" },
          "budget": {
            "type": "object",
            "required": ["max_steps"],
            "properties": {
              "max_steps": { "type": "integer", "minimum": 1 },
              "max_duration_ms": { "type": "integer", "minimum": 1 },
              "max_cost": { "type": "number", "minimum": 0 }
            }
          },
          "hypothesis": { "type": "string" },
          "intervention": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["suite", "metrics"],
      "properties": {
        "suite": { "type": "string" },
        "metrics": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "resolution": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["select", "synthesize_knowledge"] },
        "validation_branch_required": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}

