{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/consciousness-experiment-manifest.schema.json",
  "title": "GenOS consciousness experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registryVersion", "theoryId", "hypothesisId", "profileId", "revision", "seeds", "locks", "thresholds", "protocol", "status", "claimBoundary"],
  "properties": {
    "schema": { "const": "genos.consciousness-experiment-manifest/v1" },
    "registryVersion": { "const": "genos.consciousness-experiment-registry/v1" },
    "theoryId": { "$ref": "#/$defs/id" },
    "hypothesisId": { "$ref": "#/$defs/id" },
    "profileId": { "$ref": "#/$defs/id" },
    "revision": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "seeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "locks": {
      "type": "object", "additionalProperties": false, "required": ["model", "toolset", "budget"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "toolset": { "type": "string", "minLength": 1 },
        "budget": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false, "required": ["minimumEffect", "confoundTolerance"],
      "properties": {
        "minimumEffect": { "type": "number", "exclusiveMinimum": 0 },
        "confoundTolerance": { "type": "number", "minimum": 0 }
      }
    },
    "protocol": { "$ref": "https://genos.ai/spec/consciousness-experiment-registry.schema.json#/$defs/hypothesis" },
    "status": { "const": "specified" },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["phenomenalExperience", "phenomenalInferenceAllowed", "promotionAllowed"],
      "properties": {
        "phenomenalExperience": { "const": "unassessed" },
        "phenomenalInferenceAllowed": { "const": false },
        "promotionAllowed": { "const": false }
      }
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" } }
}
