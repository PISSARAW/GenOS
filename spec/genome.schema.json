{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/genome.schema.json",
  "title": "AgentGenome",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "identity", "cognition", "memory", "models", "tools"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "type": "string", "const": "AgentGenome" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string" }
      }
    },
    "cognition": { "type": "object" },
    "memory": { "type": "object" },
    "models": { "type": "object" },
    "tools": { "type": "object" },
    "policies": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
