{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/genome.schema.json",
  "title": "AgentGenome",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "identity", "cognition", "memory", "models", "tools"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "type": "string", "const": "AgentGenome" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string" }
      }
    },
    "cognition": { "type": "object" },
    "drives": {
      "type": "object",
      "description": "Stable behavioral tendencies, distinct from objectives and policies.",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "parent_genomes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "memory": { "type": "object" },
    "models": { "type": "object" },
    "tools": { "type": "object" },
    "policies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inferred_traits": {
      "type": "array",
      "items": { "$ref": "genome-trait-claim.schema.json" }
    },
    "breeding": {
      "type": ["object", "null"],
      "properties": {
        "status": { "enum": ["untested_candidate", "validated", "rejected"] },
        "targets": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "additionalProperties": true
}
