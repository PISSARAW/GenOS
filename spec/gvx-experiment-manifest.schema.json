{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/gvx-experiment-manifest.schema.json",
  "title": "GVX experimental provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "payload", "hash"],
  "properties": {
    "schema": { "const": "genos.gvx.experiment-manifest/v1" },
    "canonicalization": { "const": "genos-json/v1" },
    "hash": { "$ref": "#/$defs/hash" },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["experimentId", "scope", "snapshotHash", "candidateHash", "controls", "worldBudget", "planHash", "arms", "provenance"],
      "properties": {
        "experimentId": { "$ref": "#/$defs/id" },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["organizationId", "projectId", "entityId"],
          "properties": {
            "organizationId": { "$ref": "#/$defs/id" },
            "projectId": { "$ref": "#/$defs/id" },
            "entityId": { "$ref": "#/$defs/id" }
          }
        },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "candidateHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "controls": {
          "type": "object", "required": ["model", "toolsetHash", "environmentHash"],
          "properties": {
            "model": { "$ref": "#/$defs/id" },
            "toolsetHash": { "$ref": "#/$defs/hash" },
            "environmentHash": { "$ref": "#/$defs/hash" }
          }
        },
        "worldBudget": { "type": "number", "exclusiveMinimum": 0 },
        "planHash": { "$ref": "#/$defs/hash" },
        "arms": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["armId", "worldId", "role", "isolationId"],
            "properties": {
              "armId": { "$ref": "#/$defs/id" }, "worldId": { "$ref": "#/$defs/id" },
              "role": { "$ref": "#/$defs/id" }, "isolationId": { "$ref": "#/$defs/id" }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["mission", "run", "claims", "hypotheses", "interventions", "versions", "lineage", "costUnit", "artifacts", "receiptRefs"],
      "properties": {
        "mission": {
          "type": "object", "additionalProperties": false, "required": ["id", "contractHash"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "contractHash": { "$ref": "#/$defs/hash" } }
        },
        "run": {
          "type": "object", "additionalProperties": false, "required": ["id", "parentRunId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "parentRunId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
          }
        },
        "claims": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "statementHash", "status", "sourceRefs"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "statementHash": { "$ref": "#/$defs/hash" },
              "status": { "enum": ["proposed", "rejected", "retracted"] }, "sourceRefs": { "$ref": "#/$defs/ids" }
            }
          }
        },
        "hypotheses": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "claimIds", "predictionHash", "status"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "claimIds": { "$ref": "#/$defs/ids", "minItems": 1 },
              "predictionHash": { "$ref": "#/$defs/hash" }, "status": { "enum": ["open", "refuted", "withdrawn"] }
            }
          }
        },
        "interventions": {
          "type": "array", "minItems": 2, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "armId", "hypothesisIds", "descriptionHash"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "armId": { "$ref": "#/$defs/id" },
              "hypothesisIds": { "$ref": "#/$defs/ids", "minItems": 1 }, "descriptionHash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "versions": {
          "type": "object", "additionalProperties": false, "required": ["codeRevision", "sourceTreeHash"],
          "properties": {
            "codeRevision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
            "sourceTreeHash": { "$ref": "#/$defs/hash" }
          }
        },
        "lineage": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["runId", "manifestHash"],
            "properties": { "runId": { "$ref": "#/$defs/id" }, "manifestHash": { "$ref": "#/$defs/hash" } }
          }
        },
        "costUnit": { "$ref": "#/$defs/id" },
        "artifacts": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["artifactId", "kind", "sha256"],
            "properties": {
              "artifactId": { "$ref": "#/$defs/id" }, "kind": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "receiptRefs": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["receiptId", "sha256"],
            "properties": { "receiptId": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/hash" } }
          }
        }
      }
    }
  }
}
