{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.dev/spec/personal-causal-replay.schema.json",
  "title": "GenOS Personal Causal Replay Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "checkpoint", "history_end", "events", "intervention"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_ref", "at", "state"],
      "properties": {
        "agent_ref": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "state": { "type": "object" }
      }
    },
    "history_end": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_event_id", "replacement"],
      "properties": {
        "target_event_id": { "type": "string", "minLength": 1 },
        "replacement": { "$ref": "#/$defs/event" }
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["equals", "not_equals", "greater_than", "greater_or_equal", "less_than", "less_or_equal", "exists", "missing"] },
        "value": true
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["set", "add", "multiply", "remove"] },
        "value": true,
        "when": { "type": "array", "items": { "$ref": "#/$defs/predicate" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "occurred_at", "kind", "description"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["decision", "observation", "action", "outcome", "external"] },
        "description": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/predicate" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      }
    }
  }
}
