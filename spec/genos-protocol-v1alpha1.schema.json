{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.dev/spec/genos-protocol-v1alpha1.schema.json",
  "title": "GenOS Protocol Result v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "genos.protocol/v1alpha1"
    },
    "operation": {
      "enum": [
        "create",
        "snapshot",
        "restore",
        "fork",
        "run",
        "inspect",
        "diff",
        "lineage",
        "replay",
        "merge"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "output": true,
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "operation",
    "exit_code",
    "stdout",
    "stderr"
  ]
}
