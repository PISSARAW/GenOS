{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.dev/spec/cognitive-merge.schema.json",
  "title": "GenOS Cognitive Merge Manifest",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["claims"], "not": { "required": ["experiences"] } },
    { "required": ["experiences"], "not": { "required": ["claims"] } }
  ],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experience" }
    },
    "relations": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/relation" }
    },
    "config": { "$ref": "#/$defs/config" },
    "parent_snapshot": { "type": "object" }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "branch_id", "subject", "predicate", "object_value", "confidence", "evidence"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "object_value": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "kind": { "enum": ["fact", "hypothesis", "observation", "contradiction", "preference", "result", "discovery"] },
        "statement": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "experience_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "description"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id"],
      "properties": {
        "branch_id": { "type": "string", "minLength": 1 },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "beliefs_created": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "beliefs_modified": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "discoveries": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "uncertainty": { "type": "array", "items": { "$ref": "#/$defs/experience_item" } },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_claim", "to_claim", "kind", "confidence", "evidence"],
      "properties": {
        "from_claim": { "type": "string", "minLength": 1 },
        "to_claim": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["supports", "contradicts", "explains", "supersedes", "qualifies"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_threshold", "minimum_independent_branches"],
      "properties": {
        "acceptance_threshold": { "$ref": "#/$defs/confidence" },
        "minimum_independent_branches": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
