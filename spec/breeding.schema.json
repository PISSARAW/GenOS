{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/breeding.schema.json",
  "title": "GenomeBreedingRecord",
  "type": "object",
  "required": ["breeding_id", "parents", "strategy", "candidate", "validation"],
  "properties": {
    "breeding_id": { "type": "string" },
    "parents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["genome_digest", "phenotype_observation"],
        "properties": {
          "genome_digest": { "type": "string", "pattern": "^sha256:" },
          "phenotype_observation": { "type": "string" }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["name", "trait_targets"],
      "properties": {
        "name": { "enum": ["weighted_recombination", "pareto_recombination", "constraint_guided"] },
        "trait_targets": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["genome_digest", "status"],
      "properties": {
        "genome_digest": { "type": "string", "pattern": "^sha256:" },
        "status": { "const": "untested_candidate" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["evaluation_suite", "minimum_repetitions"],
      "properties": {
        "evaluation_suite": { "type": "string" },
        "minimum_repetitions": { "type": "integer", "minimum": 2 }
      }
    }
  },
  "additionalProperties": true
}

