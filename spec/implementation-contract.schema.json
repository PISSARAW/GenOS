{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.ai/spec/implementation-contract.schema.json",
  "title": "GenOS Implementation Contract",
  "type": "object",
  "required": [
    "apiVersion", "kind", "id", "type", "interpretation", "targets",
    "invariant", "mechanism", "observables", "falsificationTests", "limits",
    "permissions", "obligations", "prohibitions", "violationCriteria",
    "responsibility", "maturity", "status", "scenario", "experiment"
  ],
  "properties": {
    "apiVersion": { "const": "genos.contract/v1" },
    "kind": { "const": "ImplementationContract" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "type": { "type": "string", "enum": ["concept", "notion", "constraint", "norm", "theory", "method", "lens"] },
    "category": { "type": "string", "enum": ["state", "transformation", "constraint", "organization", "evaluation"] },
    "interpretation": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "invariant": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "observables": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "falsificationTests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "obligations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prohibitions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "violationCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "responsibility": { "type": "string", "minLength": 1 },
    "scenario": {
      "type": "object",
      "required": ["id", "contractId", "mode", "stimulus", "observation"],
      "properties": {
        "id": { "type": "string" },
        "contractId": { "type": "string" },
        "mode": { "type": "string", "minLength": 1 },
        "stimulus": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["id", "hypothesis", "baseline", "successCondition", "rejectionCondition", "evidenceRequired", "topologies", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "successCondition": { "type": "string", "minLength": 1 },
        "rejectionCondition": { "type": "string", "minLength": 1 },
        "evidenceRequired": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "topologies": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "const": "planned" }
      },
      "additionalProperties": false
    },
    "maturity": { "type": "string", "enum": ["registered", "defined", "mechanism-linked", "observable", "tested", "integrated", "validated"] },
    "status": { "type": "string", "enum": ["candidate", "approved", "rejected", "disabled"] }
  },
  "additionalProperties": true
}
