{
  "name": "genos_advanced_budget_allocation",
  "description": "Perform advanced budget and token allocation across branches.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "total_budget": { "type": "number", "description": "The total budget to allocate" },
      "scenarios": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Scenarios to allocate budget among"
      },
      "entropy": { "type": "number" }
    },
    "required": ["total_budget", "scenarios"]
  }
}
