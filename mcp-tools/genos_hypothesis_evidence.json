{
  "name": "genos_hypothesis_evidence",
  "description": "Attach provenance-bearing evidence and update a hypothesis confidence/status.",
  "parameters": {
    "type": "object",
    "properties": {
      "diagnosis_id": { "type": "string", "description": "The diagnosis ID" },
      "hypothesis_id": { "type": "string", "description": "The hypothesis ID" },
      "claim": { "type": "string", "description": "The claim text" },
      "source": { "type": "string", "description": "Source of the evidence" },
      "artifact": { "type": "string", "description": "Artifact attached to the evidence" },
      "against": { "type": "boolean", "description": "True if the evidence contradicts the hypothesis" },
      "confidence": { "type": "number", "description": "Confidence score" }
    },
    "required": ["diagnosis_id", "hypothesis_id", "claim", "source", "confidence"]
  }
}
