{
  "name": "genos_ais_prr_scan",
  "description": "Scanne l'environnement de l'agent à la recherche de motifs PAMPs (intrus externes) ou DAMPs (dégâts internes) via les Pattern Recognition Receptors.",
  "parameters": {
    "type": "object",
    "properties": {
      "agent_id": {
        "type": "string",
        "description": "ID de l'agent"
      },
      "patterns_detected": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Liste des signaux détectés (ex: 'PromptInjectionSignature', 'ContextPollution')"
      }
    },
    "required": ["agent_id", "patterns_detected"]
  }
}
