namespace GenOS {
  entity Agent = {
    agentId: String,
    workspaceId: String,
    executionMode: String,
    parentId: String,
    sealedDispatchParentId: String
  };
  action "Control" appliesTo {
    principal: Agent,
    resource: Agent,
    context: { workspaceId: String }
  };
  action "StartMission" appliesTo {
    principal: Agent,
    resource: Agent,
    context: { workspaceId: String }
  };
}
