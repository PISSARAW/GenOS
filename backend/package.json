{
  "name": "genos-backend",
  "version": "1.0.0",
  "description": "GenOS Agent Runtime API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/test_backend.js",
    "test:grpc": "node tests/test_grpc_services.js",
    "apoptosis": "node bin/genos-apoptosis.cjs",
    "daemon": "node bin/genos-daemon.cjs",
    "daemon:interactive": "node bin/genos-daemon.cjs --interactive",
    "daemon:audit": "node bin/genos-daemon.cjs --scan-only",
    "autostart:enable": "node bin/genos-daemon.cjs --enable-autostart",
    "autostart:disable": "node bin/genos-daemon.cjs --disable-autostart",
    "autostart:status": "node bin/genos-daemon.cjs --status"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@node-saml/node-saml": "^5.1.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lru-cache": "^11.5.2",
    "msgpackr": "^2.1.0",
    "protobufjs": "^8.8.0",
    "sqlite": "^5.1.1",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^6.0.1"
  }
}
