{
  "schema": "genos.effector-registry/v1",
  "profile": "node-runtime",
  "boundary": "Agent-mediated effects routed through the Node backend and runtime launch paths",
  "inventoryStatus": "scoped_with_gaps",
  "effectors": [
    {
      "id": "orchestration_action",
      "sourceRefs": ["backend/src/services/orchestrationActionExecutor.js"],
      "predictionHook": "orchestrationActionExecutor.recordEfference",
      "outcomeEvents": ["ORCHESTRATION_ACTION_EXECUTED", "ORCHESTRATION_ACTION_FAILED"],
      "correlation": "source event ID",
      "status": "covered"
    },
    {
      "id": "backend_mcp_tool",
      "sourceRefs": ["backend/src/services/mcpExecutor.js"],
      "predictionHook": "mcpExecutor.recordToolEfference",
      "outcomeEvents": ["WORKFLOW_MCP_TOOL_COMPLETED", "WORKFLOW_MCP_TOOL_FAILED"],
      "correlation": "sourceActionId",
      "status": "covered"
    },
    {
      "id": "mission_runtime_process",
      "sourceRefs": ["backend/src/services/runtimeProcessReceipt.js", "backend/src/services/agentProcessOutcome.js"],
      "predictionHook": "runtimeProcessReceipt.predict",
      "outcomeEvents": ["AGENT_COMPLETED", "AGENT_FAILED", "AGENT_HALTED"],
      "correlation": "sourceActionId and body_action_receipts.action_id",
      "status": "covered",
      "limitation": "Bound Node mission processes only; a legacy unbound mission has no sealed body action."
    },
    {
      "id": "worker_dispatch",
      "sourceRefs": ["backend/src/services/agentRuntimeAdapter/missionWorkers.js", "backend/src/services/agentFleetService.js"],
      "predictionHook": "bodyActionReceiptService.predict",
      "outcomeEvents": ["WORKER_DISPATCH_SELECTED", "WORKER_DISPATCH_FAILED", "AGENT_COMPLETED", "AGENT_FAILED"],
      "correlation": "sourceActionId and body_action_receipts.action_id",
      "status": "covered",
      "limitation": "Bound Node dispatch only; later worker execution has its own process action."
    },
    {
      "id": "direct_mcp_call",
      "sourceRefs": ["backend/src/services/mcpExecutor/directCall.js"],
      "predictionHook": "bodyActionReceiptService.predict when a sealed actor is supplied",
      "outcomeEvents": [],
      "correlation": "body_action_receipts.action_id when actor is bound",
      "status": "conditional",
      "limitation": "External direct calls without a sealed actor remain unattributed."
    },
    {
      "id": "local_runtime_filesystem",
      "sourceRefs": ["backend/src/services/runtimeFilesystemReceipt.js"],
      "predictionHook": "runtimeFilesystemReceipt.begin",
      "outcomeEvents": ["AGENT_COMPLETED", "AGENT_FAILED"],
      "correlation": "body_action_receipts.action_id",
      "status": "partial",
      "limitation": "Eligible files are compared before and after a local runtime. Changes are only temporally correlated; ignored paths and concurrent writers are not attributable."
    },
    {
      "id": "rust_mcp_stdio",
      "sourceRefs": ["mcp/index.js", "crates/genos-mcp/src/main.rs"],
      "predictionHook": null,
      "outcomeEvents": [],
      "correlation": null,
      "status": "outside_node_boundary",
      "limitation": "Rust stdio results identify external/unattributed origin, but direct execution is not observed by the Node efference ledger."
    }
  ],
  "limitation": "Inventory is explicit for known agent-mediated action channels; uncovered and out-of-band effectors are not treated as validated."
}
