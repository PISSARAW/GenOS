{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genos.local/schemas/morphProtocol.v1.schema.json",
  "title": "GenOS MORPH v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "messageId",
    "operationId",
    "missionId",
    "conversationId",
    "type",
    "sender",
    "scope",
    "causalRefs",
    "generations",
    "authority",
    "idempotencyKey",
    "createdAt",
    "expiresAt",
    "payloadDigest",
    "payload",
    "audience"
  ],
  "properties": {
    "protocol": {"const":"genos.morph/v1"},
    "messageId": {"$ref":"#/definitions/id"},
    "operationId": {"$ref":"#/definitions/id"},
    "missionId": {"$ref":"#/definitions/id"},
    "conversationId": {"$ref":"#/definitions/id"},
    "type": {"enum":["PROPOSE","QUIESCE","CHECKPOINT","PREPARE","READY","COMMIT","FINALIZE","REJECT","ABORT","RECOVERY_REQUIRED"]},
    "sender": {"$ref":"#/definitions/actor"},
    "scope": {"$ref":"#/definitions/scope"},
    "causalRefs": {"$ref":"#/definitions/refs"},
    "generations": {"$ref":"#/definitions/generations"},
    "authority": {"$ref":"#/definitions/authority"},
    "idempotencyKey": {"$ref":"#/definitions/id"},
    "createdAt": {"type":"string","format":"date-time"},
    "expiresAt": {"type":"string","format":"date-time"},
    "payloadDigest": {"$ref":"#/definitions/digest"},
    "payload": {"type":"object"},
    "audience": {"$ref":"#/definitions/actor"}
  },
  "allOf": [
    {
      "if": {"properties":{"type":{"const":"PROPOSE"}}},
      "then": {"properties":{"payload":{"type":"object","additionalProperties":false,"required":["plan"],"properties":{"plan":{"$ref":"#/definitions/plan"}}}}}
    },
    {
      "if": {"properties":{"type":{"const":"QUIESCE"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"CHECKPOINT"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"PREPARE"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"READY"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest","receiptDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"},"receiptDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"COMMIT"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"FINALIZE"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"REJECT"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest","reason"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"},"reason":{"$ref":"#/definitions/id"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"ABORT"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"}}
          }
        }
      }
    },
    {
      "if": {"properties":{"type":{"const":"RECOVERY_REQUIRED"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transitionId","planDigest","reason"],
            "properties": {"transitionId":{"$ref":"#/definitions/id"},"planDigest":{"$ref":"#/definitions/digest"},"reason":{"$ref":"#/definitions/id"}}
          }
        }
      }
    }
  ],
  "definitions": {
    "id": {"type":"string","minLength":1,"maxLength":512,"pattern":"^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"},
    "digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "refs": {"type":"array","maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/definitions/id"}},
    "generation": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId","incarnationId","trustDomain"],
      "properties": {"agentId":{"$ref":"#/definitions/id"},"incarnationId":{"$ref":"#/definitions/id"},"trustDomain":{"$ref":"#/definitions/id"}}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId","projectId"],
      "properties": {"organizationId":{"$ref":"#/definitions/id"},"projectId":{"$ref":"#/definitions/id"}}
    },
    "generations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incarnation","organization","workspace"],
      "properties": {"incarnation":{"$ref":"#/definitions/generation"},"organization":{"$ref":"#/definitions/generation"},"workspace":{"$ref":"#/definitions/generation"}}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId","generation"],
      "properties": {"authorityId":{"$ref":"#/definitions/id"},"generation":{"$ref":"#/definitions/generation"}}
    },
    "content": {"type":"object"},
    "topology": {"enum":["a_team","biocenose","biome","holobionte","metapopulation","rhizome","syncytium","trinity"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId","owner","content"],
      "properties": {"taskId":{"$ref":"#/definitions/id"},"owner":{"$ref":"#/definitions/actor"},"content":{"$ref":"#/definitions/content"}}
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligationId","owner","requirements","content"],
      "properties": {"obligationId":{"$ref":"#/definitions/id"},"owner":{"$ref":"#/definitions/actor"},"requirements":{"$ref":"#/definitions/refs"},"content":{"$ref":"#/definitions/content"}}
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId","holder","resources","actions","conditions"],
      "properties": {
        "grantId": {"$ref":"#/definitions/id"},
        "holder": {"$ref":"#/definitions/actor"},
        "resources": {"$ref":"#/definitions/refs"},
        "actions": {"$ref":"#/definitions/refs"},
        "conditions": {"$ref":"#/definitions/content"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetId","owner","unit","limit","spent","reserved"],
      "properties": {
        "budgetId": {"$ref":"#/definitions/id"},
        "owner": {"$ref":"#/definitions/actor"},
        "unit": {"$ref":"#/definitions/id"},
        "limit": {"$ref":"#/definitions/generation"},
        "spent": {"$ref":"#/definitions/generation"},
        "reserved": {"$ref":"#/definitions/generation"}
      }
    },
    "claim": {"type":"object","additionalProperties":false,"required":["claimId","content"],"properties":{"claimId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId","content"],
      "properties": {"evidenceId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}
    },
    "provenance": {"type":"object","additionalProperties":false,"required":["agentId","content"],"properties":{"agentId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}},
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyId","content"],
      "properties": {"dependencyId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertaintyId","content"],
      "properties": {"uncertaintyId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId","content"],
      "properties": {"questionId":{"$ref":"#/definitions/id"},"content":{"$ref":"#/definitions/content"}}
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId","recipients","contentDigest"],
      "properties": {"messageId":{"$ref":"#/definitions/id"},"recipients":{"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/actor"}},"contentDigest":{"$ref":"#/definitions/digest"}}
    },
    "unknownEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectId","owner","content"],
      "properties": {"effectId":{"$ref":"#/definitions/id"},"owner":{"$ref":"#/definitions/actor"},"content":{"$ref":"#/definitions/content"}}
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology","members","tasks","obligations","permissions","budgets","claims","evidence","provenance","dependencies","audiences","uncertainties","questions","unknownEffects"],
      "properties": {
        "topology": {"$ref":"#/definitions/topology"},
        "members": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/actor"},"minItems":1},
        "tasks": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/task"}},
        "obligations": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/obligation"}},
        "permissions": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/permission"}},
        "budgets": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/budget"}},
        "claims": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/claim"}},
        "evidence": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/evidence"}},
        "provenance": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/provenance"}},
        "dependencies": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/dependency"}},
        "audiences": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/audience"}},
        "uncertainties": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/uncertainty"}},
        "questions": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/question"}},
        "unknownEffects": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/unknownEffect"}}
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","id","from","to"],
      "properties": {
        "kind": {"enum":["tasks","obligations","permissions","budgets","unknownEffects"]},
        "id": {"$ref":"#/definitions/id"},
        "from": {"$ref":"#/definitions/actor"},
        "to": {"$ref":"#/definitions/actor"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionId","sourceVersion","targetVersion","participants","coordinator","sourceSnapshot","targetSnapshot","transfers"],
      "properties": {
        "transitionId": {"$ref":"#/definitions/id"},
        "sourceVersion": {"$ref":"#/definitions/generation"},
        "targetVersion": {"$ref":"#/definitions/generation"},
        "participants": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/actor"},"minItems":1},
        "coordinator": {"$ref":"#/definitions/actor"},
        "sourceSnapshot": {"$ref":"#/definitions/snapshot"},
        "targetSnapshot": {"$ref":"#/definitions/snapshot"},
        "transfers": {"type":"array","maxItems":1000,"items":{"$ref":"#/definitions/transfer"}}
      }
    }
  }
}
