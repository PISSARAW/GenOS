{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.local/schemas/agow/cognitiveCandidate.schema.json",
  "title": "AGOW Cognitive Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateId", "agentId", "source", "content", "epistemicOrigin", "evidenceRefs", "causalParents", "measures", "constraints", "producedAt", "expiresAt", "stateHash"],
  "properties": {
    "candidateId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "content": { "$ref": "#/$defs/content" },
    "epistemicOrigin": { "$ref": "#/$defs/epistemicOrigin" },
    "epistemicContext": { "$ref": "#/$defs/epistemicContext" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "causalParents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "measures": { "$ref": "#/$defs/measures" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "redundancyKey": { "type": ["string", "null"] },
    "producedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "stateHash": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "modality"],
      "properties": { "module": { "type": "string", "minLength": 1 }, "instanceId": { "type": ["string", "null"] }, "modality": { "type": "string", "minLength": 1 } }
    },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticType"],
      "properties": { "semanticType": { "type": "string", "minLength": 1 }, "artifactRef": { "type": ["string", "null"] }, "compactPreview": { "type": ["string", "null"], "maxLength": 2000 } }
    },
    "epistemicOrigin": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "realityMode", "agency", "simulationId", "parentRealityFrameId"],
      "properties": {
        "origin": { "enum": ["external_observed", "tool_observed", "other_agent_observed", "self_action_expected", "self_action_observed", "self_generated", "memory_retrieved", "model_inferred", "counterfactual_simulated", "procedural_generated", "unknown"] },
        "realityMode": { "enum": ["real", "counterfactual"] },
        "agency": { "enum": ["self", "other", "environment", "unknown"] },
        "simulationId": { "type": ["string", "null"] },
        "parentRealityFrameId": { "type": ["string", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "realityMode": { "const": "counterfactual" } } }, "then": { "properties": { "simulationId": { "type": "string", "minLength": 1 }, "parentRealityFrameId": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "origin": { "const": "counterfactual_simulated" } } }, "then": { "properties": { "realityMode": { "const": "counterfactual" } } } },
        { "if": { "properties": { "realityMode": { "const": "real" } } }, "then": { "properties": { "simulationId": { "type": "null" } } } }
      ]
    },
    "epistemicContext": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "beliefImportance": { "$ref": "#/$defs/unit" },
        "causalDescendantCount": { "type": "integer", "minimum": 0 },
        "irreversibility": { "$ref": "#/$defs/unit" },
        "expectedAllostaticState": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "energy": { "$ref": "#/$defs/unit" }, "memoryPressure": { "$ref": "#/$defs/unit" },
            "socialState": { "$ref": "#/$defs/unit" }, "modelDrift": { "$ref": "#/$defs/unit" },
            "contextPressure": { "$ref": "#/$defs/unit" }, "integrity": { "$ref": "#/$defs/unit" },
            "stress": { "$ref": "#/$defs/unit" }
          }
        }
      }
    },
    "measures": {
      "type": "object", "additionalProperties": false,
      "required": ["predictionError", "uncertainty", "goalRelevance", "expectedInformationGain", "urgency", "novelty", "actionability", "causalConfidence", "evidenceDebt", "estimatedCost"],
      "properties": {
        "predictionError": { "$ref": "#/$defs/unit" }, "uncertainty": { "$ref": "#/$defs/unit" }, "goalRelevance": { "$ref": "#/$defs/unit" }, "expectedInformationGain": { "$ref": "#/$defs/unit" }, "urgency": { "$ref": "#/$defs/unit" }, "novelty": { "$ref": "#/$defs/unit" }, "actionability": { "$ref": "#/$defs/unit" }, "causalConfidence": { "$ref": "#/$defs/unit" }, "evidenceDebt": { "$ref": "#/$defs/unit" }, "estimatedCost": { "type": "number", "minimum": 0 }
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["safety", "integrity", "viability", "userPolicy"],
      "properties": { "safety": { "enum": ["clear", "review", "blocked"] }, "integrity": { "enum": ["clear", "review", "blocked"] }, "viability": { "enum": ["clear", "review", "blocked"] }, "userPolicy": { "enum": ["clear", "review", "blocked"] } }
    }
  }
}
