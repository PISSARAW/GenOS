{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.local/schemas/agow/broadcastReceipt.schema.json",
  "title": "AGOW Broadcast Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "frameId", "module", "consumed", "beforeStateHash", "afterStateHash", "effectType", "changed", "artifactRefs", "createdAt"],
  "properties": {
    "receiptId": { "type": "string", "minLength": 1 }, "frameId": { "type": "string", "minLength": 1 }, "module": { "type": "string", "minLength": 1 }, "consumed": { "type": "boolean" },
    "beforeStateHash": { "type": ["string", "null"] }, "afterStateHash": { "type": ["string", "null"] }, "effectType": { "type": ["string", "null"] }, "changed": { "type": "boolean" }, "artifactRefs": { "type": "array", "items": { "type": "string" } }, "createdAt": { "type": "integer", "minimum": 0 }
  }
}
