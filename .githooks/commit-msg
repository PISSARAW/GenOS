#!/bin/bash
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

if [[ ! "$COMMIT_MSG" =~ ^\[[A-Z]+\] ]]; then
  echo "❌ [Système Immunitaire] Rejet du commit !"
  echo "Le message doit commencer par un tag en majuscules entre crochets."
  echo "Exemples valides :"
  echo "  [EVOLUTION] Ajoute le RAG"
  echo "  [FIX] Répare la mitose"
  echo "  [CHORE] Met à jour les dépendances"
  echo ""
  echo "Votre message était :"
  echo "$COMMIT_MSG"
  exit 1
fi

# GenOS Commit Receipt (fail-closed).
# - [FEAT]/[FIX]/[EVOLUTION]/[REFACTOR] REQUIRE a Receipt: block.
# - When a Receipt: block is present, declared files must exactly match
#   the staged diff (verified by scripts/ci/commit_receipt.py).
# - Python missing, or receipt mismatch, REJECTS the commit (no silent skip).
TAG=$(echo "$COMMIT_MSG" | sed -n 's/^\[\([A-Z]*\)\].*/\1/p')
REQUIRES_RECEIPT=0
case "$TAG" in
  FEAT|FIX|EVOLUTION|REFACTOR) REQUIRES_RECEIPT=1 ;;
esac

HAS_RECEIPT=0
if grep -qi "^Receipt:" "$COMMIT_MSG_FILE"; then
  HAS_RECEIPT=1
fi

if [ "$REQUIRES_RECEIPT" -eq 1 ] && [ "$HAS_RECEIPT" -eq 0 ]; then
  echo "❌ [Commit Receipt] Bloc Receipt: manquant."
  echo "Les commits [$TAG] doivent lister exactement les fichiers stagés."
  echo "Ajoutez à la fin du message :"
  echo "  Receipt:"
  git diff --cached --name-only | sed 's/^/    /'
  exit 1
fi

if [ "$HAS_RECEIPT" -eq 1 ]; then
  PYTHON_BIN=""
  for candidate in python3 py python "$LOCALAPPDATA/Programs/Python/Python312/python.exe"; do
    if [ -n "$candidate" ] && "$candidate" -c "import sys" 2>/dev/null; then
      PYTHON_BIN="$candidate"
      break
    fi
  done
  if [ -z "$PYTHON_BIN" ]; then
    echo "❌ [Commit Receipt] Python introuvable : vérification impossible, commit rejeté (fail-closed)."
    exit 1
  fi
  "$PYTHON_BIN" scripts/ci/commit_receipt.py "$COMMIT_MSG_FILE"
  exit_code=$?
  if [ $exit_code -ne 0 ]; then
    exit $exit_code
  fi
fi
