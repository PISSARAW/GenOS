{
  "schema_version": 1,
  "result_contract": {
    "required_fields": [
      "score",
      "metrics",
      "sample_count",
      "dataset_revision",
      "dataset_checksum",
      "runtime"
    ],
    "score_rule": "Keep each upstream benchmark score in its native scale. Do not average scores across different public benchmarks."
