{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omega-bench-2026/scenario/v1",
  "type": "object",
  "required": ["scenario_id", "experiment_id", "seed", "input"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^E[0-9]{2}-[0-9]{3}$"},
    "experiment_id": {"type": "string", "pattern": "^E(0[1-9]|1[0-2])$"},
    "seed": {"type": "integer"},
    "input": {"type": "object"}
  },
  "additionalProperties": false
}
