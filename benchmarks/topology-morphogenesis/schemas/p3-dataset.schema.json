{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.local/schemas/morphogenesis-p3-dataset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "datasetId", "split", "selectorAccess", "tasks"],
  "properties": {
    "schema": { "const": "genos.morphogenesis.p3-dataset/v1" },
    "datasetId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$" },
    "split": { "enum": ["shadow", "holdout"] },
    "selectorAccess": { "type": "boolean" },
    "trainingOracleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["taskId", "taskFamily", "prompt", "seeds", "oracleId", "oracleModule", "oracleSha256"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "taskFamily": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "seeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
          "oracleId": { "type": "string", "minLength": 1 },
          "oracleModule": { "type": "string", "minLength": 1 },
          "oracleSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
