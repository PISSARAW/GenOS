{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genos.local/schemas/topology-morphogenesis-task-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["oracle-ready-pilot-tasks", "confirmatory"] },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "oracle", "comparisonEligible", "topologyHypothesis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "prompt": { "type": "string", "minLength": 1 },
          "oracle": { "enum": ["verifyIntegerPartitions", "verifyDistinctLetters", "verifyDependencyOrder", "verifyArithmeticPartition"] },
          "comparisonEligible": { "type": "boolean" },
          "topologyHypothesis": { "type": ["string", "null"] }
        }
      }
    }
  }
}
