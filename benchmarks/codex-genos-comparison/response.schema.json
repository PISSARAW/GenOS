{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis",
    "root_cause_file",
    "root_cause_line",
    "minimal_patch",
    "evidence",
    "rejected_hypotheses",
    "verification_commands",
    "risk_assessment"
  ],
  "properties": {
    "diagnosis": { "type": "string" },
    "root_cause_file": { "type": "string" },
    "root_cause_line": { "type": "integer", "minimum": 1 },
    "minimal_patch": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "rejected_hypotheses": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "risk_assessment": { "type": "string" }
  }
}
