{
  "name": "agent-runtime-boundaries-v1",
  "version": 1,
  "workload": {
    "events": 100,
    "iterations": 500,
    "warmups": 20,
    "seed": "fixed-event-sequence-v1"
  },
  "operations": [
    "replay_event_log",
    "hash_each_input_event",
    "hash_materialized_final_state",
    "fork_world",
    "write_relative_file_from_child_process"
  ],
  "metrics": [
    "replay_fingerprint_match_rate",
    "event_hash_match_rate",
    "final_state_hash_match_rate",
    "fork_latency_ns",
    "child_write_leak_rate",
    "parent_mutation_rate",
    "environment_inheritance",
    "network_policy"
  ],
  "required_metadata": [
    "os",
    "architecture",
    "rustc_or_runtime_version",
    "hostname",
    "repository_revision",
    "snapshot_size_bytes",
    "exact_command"
  ],
  "comparison_rule": "Adapters for every system must execute the same event sequence, fault profile, iteration count, and pass/fail predicates. Unsupported capabilities must be reported as unsupported, never as zero."
}
