# =============================================================================
# GenOS V3 — .gitignore ultime
# Monorepo polyglotte : Rust (crates/) + Node (backend/, mcp/) + Python (scripts/).
# Principe (AGENTS.md) : ne jamais commiter .env, secrets, *.db ni artefacts
# generes. Un transport reussi n'est pas la preuve d'une decision valide.
# Note : ce fichier est sans effet sur les fichiers deja suivis (git ls-files).
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Secrets & environnement — JAMAIS commites
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
.secrets/
*-credentials.json
*service-account*.json
.auth/
.tokens/

# ---------------------------------------------------------------------------
# 2. Dependances (restaurees via npm ci / cargo build)
# ---------------------------------------------------------------------------
node_modules/
mcp/node_modules/
backend/node_modules/
packages/*/node_modules/
.pnp/
.pnp.js
.npm/
.yarn/
yarn-error.log
.pnpm-store/

# ---------------------------------------------------------------------------
# 3. Builds & sorties
# ---------------------------------------------------------------------------
target/
**/target/
deploy/
build/
build-iso*/
build-isolated/
dist/
out/
.next/
.turbo/
*.node
*.wasm

# Cargo.lock est VOLONTAIREMENT suivi (workspace avec binaires : genos-cli).
# Ne pas l'ajouter ici.

# ---------------------------------------------------------------------------
# 4. Rust specifique
# ---------------------------------------------------------------------------
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# 5. Python specifique
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# 6. Bases de donnees SQLite — JAMAIS commitees
# ---------------------------------------------------------------------------
*.db
*.db-*
*.db.backup*
*.backup-*
*.sqlite
*.sqlite3
*.sqlite-*
*.lbdb
*.db-shm
*.db-wal

# ---------------------------------------------------------------------------
# 7. Runtime GenOS (branches, capsules, mondes agents, sondes)
# ---------------------------------------------------------------------------
.genos/
**/.genos/
**/.genos-*
.genos-runtime/
**/.genos-runtime/
**/.genos-agent-worlds/
.genos-agent-worlds/
.genos-epoch
.genos-matrix/
.genos_agent_state.json
.codex-*
**/.codex*
capsules/
**/capsules/
fossils/
worker-sub-*/
backend/capsules/
backend/worker_mcp_orchestrator_*
backend/tests/worker_mcp_orchestrator_*
backend/worker-sub-*/
backend/.genos*
backend/.genos-runtime/
backend/.genos-agent-worlds/
backend/tests/.genos*
backend/tests/.tmp-*
backend/tests/*.db*
backend/tests/worker_mcp_orchestrator_*
backend/tests/check_*.js
backend/tests/fix_*.js
backend/tests/worker-sub-*/
backend/src/services/__pycache__/
mcp/.genos*
mcp/.codex*
crates/genos-cli/.genos*
crates/genos-cli/capsules/
crates/genos-cli/fossils/
crates/genos-orchestrator/tests/probe_*.rs

# ---------------------------------------------------------------------------
# 8. Artefacts generes (preuves, snapshots, benchmarks, couverture)
# ---------------------------------------------------------------------------
artifacts/
data/
snapshots/
test-repo/
benchmarks/**/results/
rhizome_graph.json
probe.json
cli-coverage-results.json
cli-test-results-v2.json
coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
npm-debug.log*
yarn-debug.log*

# ---------------------------------------------------------------------------
# 9. Scratch de session (travail exploratoire, pas du projet)
# ---------------------------------------------------------------------------
commit_msg.txt
commit_receipt.txt
mission.json
mission_payload.json
trinity_mission.json
trinity_riddle.json
devinette/
devinette_*.json
devinette_*.md
genos_bio_riddle_result.json
hard-stress-results.json
token-stress-results.json
run_trinity_simulation.py
simulation_trinity.md
simulation_trinity.py
simulation_trinity_complète.py
/run_*.ps1
/run_*.js
check_*.js
fix_*.js
genos_autoscan*.cjs
genos_scan_inline.cjs
scripts/audit_inbox.cjs
scripts/run_triage.cjs
scripts/triage_inbox.cjs
scripts/autonomous/genos_self_scan_wrapper.cjs
backend/scripts/genos-autoscan.cjs

# ---------------------------------------------------------------------------
# 10. Logs
# ---------------------------------------------------------------------------
*.log
logs/
backend/logs/

# ---------------------------------------------------------------------------
# 11. Temporaires & sauvegardes d'editeurs
# ---------------------------------------------------------------------------
*.tmp
*.temp
tmp/
scripts/ci/__pycache__/
scripts/diagram_enricher/
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# ---------------------------------------------------------------------------
# 12. OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# 13. IDE / editeurs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.history/
